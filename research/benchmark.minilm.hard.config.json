{
  "dataset": "hard",
  "model": {
    "model": "Xenova/paraphrase-multilingual-MiniLM-L12-v2",
    "dtype": "q8",
    "pooling": "mean",
    "maxLength": 128
  },
  "fields": [
    "title",
    "description"
  ],
  "descriptions": "datasets/hard/descriptions.json",
  "strategies": [
    "closest",
    "folder-closest",
    "manual-closest",
    "top3-average",
    "centroid",
    "hybrid",
    "rerank"
  ],
  "reranker": {
    "model": "onnx-community/bge-reranker-v2-m3-ONNX",
    "dtype": "q8",
    "candidates": 3,
    "maxLength": 512
  },
  "thresholds": {
    "newFolder": 0.55,
    "askUserMargin": 0.05
  },
  "cacheDir": ".cache/models",
  "localFilesOnly": false,
  "report": true
}
